{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/revalida/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/artifacts/api-server/index.ts"
    },
    {
      "src": "/(.*)",
      "destination": "/artifacts/revalida/$1"
    }
  ]
}